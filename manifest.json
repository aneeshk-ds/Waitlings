{
  "manifest_version": 3,
  "name": "Waitlings",
  "version": "0.2.0",
  "description": "Swaps the loading indicator in AI chat apps for small animated companions and your own phrases.",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Waitlings",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "src/core/defaults.js",
        "src/core/themes.js",
        "src/core/activities.js",
        "src/core/css.js",
        "src/adapters/claude.js",
        "src/core/engine.js"
      ],
      "run_at": "document_start"
    }
  ]
}
